#!/usr/bin/env bash
# Launch OpenCode in the foreground; kill it if the IDE heartbeat goes stale.
set -euo pipefail

HEARTBEAT="${XDG_CACHE_HOME:-$HOME/.cache}/opencode-toolbox/heartbeat"
TIMEOUT_SECS=10
GRACE_SECS=15
POLL_SECS=1

BINARY="${OPENCODE_BINARY:-/usr/local/bin/opencode}"
if [[ ! -x "$BINARY" ]]; then
  echo "opencode-session: binary not found: $BINARY" >&2
  exit 1
fi

WATCH_PID=""

kill_watchdog() {
  if [[ -n "${WATCH_PID}" ]] && kill -0 "${WATCH_PID}" 2>/dev/null; then
    kill "${WATCH_PID}" 2>/dev/null || true
    wait "${WATCH_PID}" 2>/dev/null || true
  fi
}

trap 'kill_watchdog; pkill -x opencode 2>/dev/null || true; exit 130' INT
trap 'kill_watchdog; pkill -x opencode 2>/dev/null || true; exit 143' TERM

# Watchdog in background; OpenCode must own the TTY as the foreground process.
(
  start_epoch=$(date +%s)
  seen_opencode=0
  while true; do
    if pgrep -x opencode >/dev/null 2>&1; then
      seen_opencode=1
    elif (( seen_opencode )); then
      exit 0
    fi

    now=$(date +%s)
    if [[ -f "$HEARTBEAT" ]]; then
      mtime=$(stat -c %Y "$HEARTBEAT" 2>/dev/null || echo 0)
      age=$((now - mtime))
      if (( age > TIMEOUT_SECS )); then
        echo "opencode-session: heartbeat stale (${age}s); stopping OpenCode" >&2
        pkill -x opencode 2>/dev/null || true
        exit 0
      fi
    else
      elapsed=$((now - start_epoch))
      if (( elapsed > GRACE_SECS )); then
        echo "opencode-session: no heartbeat within ${GRACE_SECS}s; stopping OpenCode" >&2
        pkill -x opencode 2>/dev/null || true
        exit 0
      fi
    fi
    sleep "$POLL_SECS"
  done
) &
WATCH_PID=$!

set +e
"$BINARY" "$@"
status=$?
set -e

kill_watchdog
trap - INT TERM
exit "$status"
